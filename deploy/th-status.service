[Unit]
Description=Raspberry Pi physical server status console
After=getty.target th-app.service nginx.service postgresql.service cloudflared.service
Conflicts=getty@tty8.service

[Service]
Type=simple
User=thapp
Group=thapp
ExecStartPre=+/usr/bin/python3 /opt/th-app/current/deploy/rpi-status.py --activate
ExecStart=/usr/bin/python3 /opt/th-app/current/deploy/rpi-status.py
ExecStopPost=+/usr/bin/python3 /opt/th-app/current/deploy/rpi-status.py --deactivate
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty8
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=64M

[Install]
WantedBy=multi-user.target
